-- ============================================
-- 6. FACT_FINAL_ORDERS
-- ============================================

CREATE TABLE fact_final_orders (
    order_id VARCHAR(20) PRIMARY KEY,
    order_date varchar(30),
    date_id varchar(10),
    customer_id VARCHAR(20),
    store_id VARCHAR(20),
    employee_id VARCHAR(20) null,
    payment_method VARCHAR(50),
    order_status VARCHAR(50),
    total_revenue DECIMAL(12,2),
    total_cost DECIMAL(12,2),

    CONSTRAINT fk_order_date
        FOREIGN KEY (date_id)
        REFERENCES dim_date_final(date_id),

    CONSTRAINT fk_order_customer
        FOREIGN KEY (customer_id)
        REFERENCES dim_customers(customer_id),

    CONSTRAINT fk_order_store
        FOREIGN KEY (store_id)
        REFERENCES dim_stores(store_id),

    CONSTRAINT fk_order_employee
        FOREIGN KEY (employee_id)
        REFERENCES dim_employees(employee_id)
);

LOAD DATA INFILE 'C:/ProgramData/MySQL/MySQL Server 8.0/Uploads/fact_final_orders.csv'
INTO TABLE fact_final_orders
FIELDS TERMINATED BY ','
ENCLOSED BY '"'
LINES TERMINATED BY '\n'
IGNORE 1 ROWS
(
    order_id,
    order_date,
    date_id,
    customer_id,
    store_id,
    @employee_id,
    payment_method,
    order_status,
    total_revenue,
    total_cost
)
SET employee_id = NULLIF(TRIM(@employee_id), '');

