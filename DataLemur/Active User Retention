SELECT
    7 AS month,
    COUNT(DISTINCT j.user_id) AS monthly_active_users
FROM user_actions j
JOIN user_actions p
    ON j.user_id = p.user_id
WHERE EXTRACT(YEAR FROM j.event_date) = 2022
  AND EXTRACT(MONTH FROM j.event_date) = 7
  AND EXTRACT(YEAR FROM p.event_date) = 2022
  AND EXTRACT(MONTH FROM p.event_date) = 6;
